# Application
APP_ENV=development
APP_NAME="Insurance Policy Review"
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/policy_review

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
# Generate a strong 32-byte string, e.g., openssl rand -hex 32
JWT_SECRET_KEY=dev_secret_key_change_in_production_123!
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Vector Database (Qdrant)
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_API_KEY=

# LLM Provider Configuration
LLM_PROVIDER=mock  # Options: gemini, openai, anthropic, mock
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Embeddings Configuration
EMBEDDING_PROVIDER=mock  # Options: gemini, openai, local, mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004

# Storage
STORAGE_PROVIDER=local  # Options: local, s3
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
